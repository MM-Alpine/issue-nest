# Local application settings.

# PostgreSQL settings shared by Docker Compose and backend scripts.
POSTGRES_HOST=localhost
POSTGRES_USER=issuehub
POSTGRES_PASSWORD=issuehub
POSTGRES_DB=issuehub_dev
POSTGRES_TEST_DB=issuehub_test
POSTGRES_PORT=5432

# Backend settings.
JWT_SECRET="local-development-jwt-secret-32-characters"
JWT_EXPIRES_IN="1d"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development

# Frontend settings.
VITE_API_URL=http://localhost:4000
