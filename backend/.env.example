# Local backend defaults. Copy to .env and adjust for your machine.

# Local development database from the repo-root docker-compose.yml.
DATABASE_URL="postgresql://issuehub:issuehub@localhost:5432/issuehub_dev?schema=public"

# Local test database. Keep this separate from DATABASE_URL because the test suite truncates data.
TEST_DATABASE_URL="postgresql://issuehub:issuehub@localhost:5432/issuehub_test?schema=public"

# Local JWT signing key. Minimum 32 characters.
JWT_SECRET="local-development-jwt-secret-32-characters"
JWT_EXPIRES_IN="1d"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development
