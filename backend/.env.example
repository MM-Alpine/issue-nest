# Copy to .env and adjust. Never commit a real secret.

# Dev database (Docker Postgres from the repo-root docker-compose.yml)
DATABASE_URL="postgresql://issuehub:issuehub@localhost:5432/issuehub_dev?schema=public"

# Test database — MUST be issuehub_test, never issuehub_dev (the suite truncates it)
TEST_DATABASE_URL="postgresql://issuehub:issuehub@localhost:5432/issuehub_test?schema=public"

# HS256 signing key. Minimum 32 characters — the app refuses to boot otherwise.
JWT_SECRET="change-me-in-production-min-32-characters-long"
JWT_EXPIRES_IN="1d"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development
