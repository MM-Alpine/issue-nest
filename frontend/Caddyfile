# Static host for the built SPA. Railway terminates TLS at the edge and injects
# PORT, so Caddy serves plain HTTP on that port and never tries to obtain certs.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Hashed Vite assets are immutable; index.html must always be revalidated so
	# a new deploy is picked up on the next load.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# SPA fallback: unknown paths are client-side routes, not 404s.
	try_files {path} /index.html
	file_server
}
